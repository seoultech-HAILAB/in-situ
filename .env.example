OPENAI_API_KEY=
# Optional: Korean explanation model; defaults to OPENAI_MODEL.
OPENAI_EXPLANATION_MODEL=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_BASE_URL=https://api.openai.com/v1
# No account login is required. Runtime data is stored under .local/.
# Never commit .env, credentials, or session exports.
